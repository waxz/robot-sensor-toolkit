<?xml version="1.0" encoding="utf-8"?>
<!--
  Differential-drive warehouse robot URDF.

  Physical parameters (loosely based on a compact AMR chassis):
    Body         : 0.60 × 0.40 × 0.20 m  (L × W × H), 18 kg
    Drive wheels : r=0.12 m, w=0.06 m, separation=0.48 m, 1.5 kg each
    Caster       : sphere r=0.05 m (rear, unpowered), 0.3 kg
    2D LiDAR     : cylinder r=0.05 m, h=0.06 m, at z=0.30 m above base
    IMU          : fixed to base at geometric centre

  Joint convention  (ROS REP-103):
    +X  forward
    +Y  left
    +Z  up
    wheel joints rotate about their local Y axis
-->
<robot name="diff_robot">

  <!-- ═══════════════════  Links  ══════════════════════════════════════════ -->

  <!-- Base chassis -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <mass value="18.0"/>
      <inertia ixx="0.214" ixy="0.0" ixz="0.0"
               iyy="0.540" iyz="0.0" izz="0.627"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.60 0.40 0.20"/>
      </geometry>
      <material name="chassis_blue">
        <color rgba="0.18 0.40 0.78 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.60 0.40 0.20"/>
      </geometry>
    </collision>
  </link>

  <!-- Left drive wheel -->
  <link name="left_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0"
               iyy="0.009" iyz="0.0" izz="0.005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.06"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.10 0.10 0.10 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.06"/>
      </geometry>
    </collision>
  </link>

  <!-- Right drive wheel -->
  <link name="right_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0"
               iyy="0.009" iyz="0.0" izz="0.005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.06"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.10 0.10 0.10 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.06"/>
      </geometry>
    </collision>
  </link>

  <!-- Rear caster ball -->
  <link name="caster_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0003" ixy="0.0" ixz="0.0"
               iyy="0.0003" iyz="0.0" izz="0.0003"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="caster_grey">
        <color rgba="0.55 0.55 0.58 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- 2D LiDAR sensor head -->
  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.18"/>
      <inertia ixx="0.00004" ixy="0.0" ixz="0.0"
               iyy="0.00004" iyz="0.0" izz="0.00006"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.06"/>
      </geometry>
      <material name="lidar_dark">
        <color rgba="0.15 0.15 0.18 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.06"/>
      </geometry>
    </collision>
  </link>

  <!-- IMU (no geometry, just a frame) -->
  <link name="imu_link"/>

  <!-- ═══════════════════  Joints  ══════════════════════════════════════════ -->

  <!-- Left wheel: z=0.12 (wheel radius), y=+0.24 (half separation) -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0.0 0.24 0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <!-- Right wheel: z=0.12, y=-0.24 -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0.0 -0.24 0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <!-- Rear caster: x=-0.25, z=0.05 (sphere radius) -->
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="-0.25 0.0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- LiDAR: z=0.20 (top of body) + 0.03 (half cylinder) = 0.23 m above base_link origin -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.10 0.0 0.23" rpy="0 0 0"/>
  </joint>

  <!-- IMU: at geometric centre of body -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.10" rpy="0 0 0"/>
  </joint>

</robot>
