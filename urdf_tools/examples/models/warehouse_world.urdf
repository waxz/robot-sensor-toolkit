<?xml version="1.0" encoding="utf-8"?>
<!--
  Warehouse world URDF — 50 × 30 × 6 m industrial warehouse.
  All geometry uses primitive shapes (box, cylinder) for wireframe rendering.
  Layout:
    • Floor slab + 4 outer walls + roof
    • 3 × 3 structural column grid at (10,25,40) × (7,15,23)
    • 6 overhead beams (3 along Y-axis + 3 along X-axis) at z ≈ 5.7 m
    • 4 rows of 5 storage-rack bays (20 total)  — amber wireframe
    • 3 loading-dock portals on the south wall — yellow frames
-->
<robot name="warehouse_world">

  <link name="world"/>

  <!-- ============================================================
       FLOOR SLAB  50 × 30 × 0.1 m
       ============================================================ -->
  <link name="floor">
    <visual>
      <origin xyz="25 15 0.05" rpy="0 0 0"/>
      <geometry><box size="50 30 0.1"/></geometry>
      <material name="floor_concrete"><color rgba="0.35 0.37 0.40 1.0"/></material>
    </visual>
  </link>
  <joint name="j_floor" type="fixed">
    <parent link="world"/><child link="floor"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       OUTER WALLS  — 6 m tall, 0.3 m thick
       ============================================================ -->
  <link name="wall_south">
    <visual>
      <origin xyz="25 0.15 3" rpy="0 0 0"/>
      <geometry><box size="50 0.3 6"/></geometry>
      <material name="wall_grey"><color rgba="0.52 0.57 0.64 0.88"/></material>
    </visual>
  </link>
  <joint name="j_wall_south" type="fixed">
    <parent link="world"/><child link="wall_south"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="wall_north">
    <visual>
      <origin xyz="25 29.85 3" rpy="0 0 0"/>
      <geometry><box size="50 0.3 6"/></geometry>
      <material name="wall_grey"><color rgba="0.52 0.57 0.64 0.88"/></material>
    </visual>
  </link>
  <joint name="j_wall_north" type="fixed">
    <parent link="world"/><child link="wall_north"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="wall_west">
    <visual>
      <origin xyz="0.15 15 3" rpy="0 0 0"/>
      <geometry><box size="0.3 30 6"/></geometry>
      <material name="wall_grey"><color rgba="0.52 0.57 0.64 0.88"/></material>
    </visual>
  </link>
  <joint name="j_wall_west" type="fixed">
    <parent link="world"/><child link="wall_west"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="wall_east">
    <visual>
      <origin xyz="49.85 15 3" rpy="0 0 0"/>
      <geometry><box size="0.3 30 6"/></geometry>
      <material name="wall_grey"><color rgba="0.52 0.57 0.64 0.88"/></material>
    </visual>
  </link>
  <joint name="j_wall_east" type="fixed">
    <parent link="world"/><child link="wall_east"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       ROOF SLAB  50 × 30 × 0.25 m  at z = 6.12
       ============================================================ -->
  <link name="roof">
    <visual>
      <origin xyz="25 15 6.12" rpy="0 0 0"/>
      <geometry><box size="50 30 0.25"/></geometry>
      <material name="roof_mat"><color rgba="0.42 0.46 0.54 0.72"/></material>
    </visual>
  </link>
  <joint name="j_roof" type="fixed">
    <parent link="world"/><child link="roof"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       STRUCTURAL COLUMNS  — 3×3 grid
       positions (x, y):  (10,7) (25,7) (40,7)
                          (10,15)(25,15)(40,15)
                          (10,23)(25,23)(40,23)
       each: cylinder r=0.18 m, 6 m tall, centre at (x, y, 3)
       ============================================================ -->
  <link name="col_r1c1">
    <visual>
      <origin xyz="0 0 3" rpy="0 0 0"/>
      <geometry><cylinder radius="0.18" length="6"/></geometry>
      <material name="col_steel"><color rgba="0.68 0.72 0.78 1.0"/></material>
    </visual>
  </link>
  <joint name="j_col_r1c1" type="fixed">
    <parent link="world"/><child link="col_r1c1"/>
    <origin xyz="10 7 0" rpy="0 0 0"/>
  </joint>

