<?xml version="1.0" encoding="utf-8"?>
<!--
  Warehouse world URDF — 50 × 30 × 6 m industrial floor plan.
  Mesh: warehouse.obj (same directory)
  Used by urdf_loader.py for Embree ray-cast benchmarks.
-->
<robot name="warehouse_world">

  <!-- Fixed world frame -->
  <link name="world"/>

  <!-- Structural envelope: walls, columns, racks, forklifts -->
  <link name="structure">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="warehouse.obj"/>
      </geometry>
      <material name="concrete">
        <color rgba="0.78 0.80 0.84 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="warehouse.obj"/>
      </geometry>
    </collision>
  </link>

  <joint name="world_to_structure" type="fixed">
    <parent link="world"/>
    <child link="structure"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Bounding-box metadata stored as a fixed phantom link -->
  <link name="scene_bounds">
    <!-- extents: 50 × 30 × 6 m -->
    <visual>
      <origin xyz="25 15 3" rpy="0 0 0"/>
      <geometry>
        <box size="50 30 6"/>
      </geometry>
      <material name="transparent">
        <color rgba="0.2 0.5 0.9 0.04"/>
      </material>
    </visual>
  </link>

  <joint name="world_to_bounds" type="fixed">
    <parent link="world"/>
    <child link="scene_bounds"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Loading-dock portals (three openings on the south wall) -->
  <link name="dock_portal_0">
    <visual>
      <origin xyz="0 0 1.75" rpy="0 0 0"/>
      <geometry>
        <box size="3.0 0.05 3.5"/>
      </geometry>
      <material name="dock_frame">
        <color rgba="0.9 0.7 0.2 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="world_to_dock_0" type="fixed">
    <parent link="world"/>
    <child link="dock_portal_0"/>
    <origin xyz="5.0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="dock_portal_1">
    <visual>
      <origin xyz="0 0 1.75" rpy="0 0 0"/>
      <geometry>
        <box size="3.0 0.05 3.5"/>
      </geometry>
      <material name="dock_frame">
        <color rgba="0.9 0.7 0.2 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="world_to_dock_1" type="fixed">
    <parent link="world"/>
    <child link="dock_portal_1"/>
    <origin xyz="20.0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="dock_portal_2">
    <visual>
      <origin xyz="0 0 1.75" rpy="0 0 0"/>
      <geometry>
        <box size="3.0 0.05 3.5"/>
      </geometry>
      <material name="dock_frame">
        <color rgba="0.9 0.7 0.2 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="world_to_dock_2" type="fixed">
    <parent link="world"/>
    <child link="dock_portal_2"/>
    <origin xyz="35.0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Utility pillars (fire-hose / emergency stations) -->
  <link name="pillar_sw">
    <collision>
      <origin xyz="0 0 3" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="6"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 3" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="6"/>
      </geometry>
      <material name="pillar_red">
        <color rgba="0.85 0.2 0.2 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="world_to_pillar_sw" type="fixed">
    <parent link="world"/>
    <child link="pillar_sw"/>
    <origin xyz="12.5 1.5 0" rpy="0 0 0"/>
  </joint>

  <link name="pillar_nw">
    <collision>
      <origin xyz="0 0 3" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="6"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 3" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="6"/>
      </geometry>
      <material name="pillar_red">
        <color rgba="0.85 0.2 0.2 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="world_to_pillar_nw" type="fixed">
    <parent link="world"/>
    <child link="pillar_nw"/>
    <origin xyz="12.5 28.5 0" rpy="0 0 0"/>
  </joint>

</robot>
